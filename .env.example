# --- PayPal (developer.paypal.com → Apps & Credentials → Sandbox) ---
# Leave both empty to run against the built-in PayPal simulator.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the sandbox app's Webhooks section (enables signature verification)
PAYPAL_WEBHOOK_ID=
# Your sandbox business account email (used as the invoicer)
PAYPAL_MERCHANT_EMAIL=

# --- Anthropic (console.anthropic.com) ---
# Leave empty to run with the offline rules engine instead of the AI agents.
ANTHROPIC_API_KEY=

# --- Policy ---
AUTO_APPROVE_LIMIT=25
RISK_HOLD_THRESHOLD=70
PORT=8787

# --- Optional: Elastic (ships the audit log to an index) ---
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=argus-audit

# Passkey step-up: approvals above this amount need a WebAuthn assertion once a passkey is enrolled
PASSKEY_STEP_UP_ABOVE=100
# Pin the WebAuthn relying party in production (defaults to the page's hostname)
# PASSKEY_RP_ID=argus.onrender.com
# Ed25519 signing keys (PKCS#8 PEM, \n-escaped). Generated per boot when unset.
# OWNER_SIGNING_KEY=
# ARGUS_SIGNING_KEY=
